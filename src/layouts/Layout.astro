---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio de David López Velasco. Desarrollo web y automatización con Python.',
} = Astro.props;

const isBlog = Astro.url.pathname.startsWith('/blog');
const logoSrc = isBlog ? '/daovez-wordmark-dark.svg' : '/daovez-wordmark.svg';
---

<!doctype html>
<html lang="es" class:list={{ 'paper-theme': isBlog }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={isBlog ? '#f3efe5' : '#24272d'} />

    <title>{title} · DAOVEZ</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>

    <header>
      <a class="brand" href="/" aria-label="DAOVEZ, inicio">
        <img src={logoSrc} alt="DAOVEZ" width="100" height="15" />
      </a>

      <nav aria-label="Navegación principal">
        <a
          href="/blog/"
          aria-current={isBlog ? 'page' : undefined}
        >
          Blog
        </a>
        <a href="https://daovez.com">Studio</a>
      </nav>
    </header>

    <main id="contenido">
      <slot />
    </main>

  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    --bg: #24272d;
    --panel: #202328;
    --text: #f0eee9;
    --muted: #b7babf;
    --accent: #94b09a;
    --line: #3c4045;

    font-family: 'Space Grotesk', Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
  }

  :root.paper-theme {
    color-scheme: light;
    --bg: #f3efe5;
    --panel: #eae5d9;
    --text: #292b28;
    --muted: #60635c;
    --accent: #506e56;
    --line: #d2cdbf;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 30px;
  }

  body {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }

  img,
  svg {
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  header,
  main,
  footer {
    width: min(960px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* Cabecera */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
  }

  .brand {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }


  .brand img {
    display: block;
    height: auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 25px;
    font-size: 14px;
  }

  nav a {
    padding: 4px 0;
  }

  nav a[aria-current='page'] {
    border-bottom: 2px solid var(--accent);
  }

  /* Texto */
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 18px;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  h2 {
    margin-bottom: 16px;
    font-size: 25px;
    line-height: 1.3;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 18px;
    line-height: 1.35;
  }

  p,
  .muted {
    color: var(--muted);
  }

  p {
    font-family: Arial, Helvetica, sans-serif;
  }

  .accent {
    color: var(--accent);
  }

  .eyebrow {
    margin-bottom: 20px;
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  /* Botones */
  .button {
    display: inline-block;
    padding: 8px 21px;
    border: 1px solid var(--accent);
    border-radius: 50px;
    font-size: 14px;
  }

  .button:hover {
    background: var(--accent);
    color: #181c19;
  }

  .status {
    color: var(--muted);
    font-size: 12px;
  }

  /* Blog y páginas de proyecto */
  .page-head {
    padding: 40px 0 25px;
  }

  .page-head p {
    max-width: 620px;
    font-size: 16px;
  }

  .prose {
    max-width: 700px;
    padding: 35px 0 60px;
    overflow-wrap: anywhere;
  }

  .prose h2 {
    margin-top: 30px;
  }

  .prose p {
    font-size: 16px;
    line-height: 1.8;
  }

  .prose pre {
    overflow-x: auto;
    padding: 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .back {
    display: inline-block;
    margin-bottom: 25px;
    color: var(--accent);
    font-size: 14px;
  }

  /* Accesibilidad */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 18px;
    z-index: 10;
    padding: 10px 15px;
    background: var(--panel);
    border: 1px solid var(--accent);
  }

  .skip-link:focus {
    top: 10px;
  }

  /* Móvil */
  @media (max-width: 650px) {
    header,
    main,
    footer {
      width: calc(100% - 36px);
    }

    header {
      gap: 14px;
      padding: 20px 0;
    }

    .brand {
      font-size: 18px;
    }

    nav {
      gap: 17px;
      font-size: 13px;
    }

    h1 {
      font-size: 30px;
    }

    h2 {
      font-size: 23px;
    }

    .page-head {
      padding-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
