---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    slug: 'automatizador-emails',
    title: 'Automatizador de emails',
    description: 'Envíos programados y gestión de contactos con Python.',
    caption: 'Automatización con Python',
  },
  {
    slug: 'portfolio-daovez',
    title: 'Portfolio DAOVEZ',
    description: 'Mi espacio de proyectos, desarrollo y aprendizaje.',
    caption: 'Diseño y desarrollo web',
  },
];
---

<Layout title="David López Velasco">
  <section id="about" class="about">
    <div class="intro">
      <h1>David López</h1>

      <p class="lead">
        Desarrollo web y automatización con IA.
      </p>

      <p class="summary">
        Creo herramientas para simplificar tareas y comparto lo que aprendo por el camino
      </p>

    </div>

    <div class="portrait-area">
      <img
        class="portrait"
        src="/images/david.webp"
        alt="David López Velasco sonriendo, con gafas y los brazos cruzados"
        width="250"
        height="250"
        fetchpriority="high"
      />

      <div class="social">
        <a
          href="https://github.com/daovez"
          aria-label="GitHub de David, abre otra pestaña"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            viewBox="0 0 24 24"
            width="23"
            height="23"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.34-3.8-1.34-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.07-1.15 3.07-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"
            />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/daovez/" aria-label="LinkedIn de David, abre otra pestaña" title="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="23" height="23" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8v-4.64c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.72H9.53V9.2h2.83v1.3h.04c.39-.74 1.36-1.53 2.79-1.53 2.98 0 3.56 1.96 3.56 4.5v5.28Z"/></svg>
        </a>
        <a href="https://x.com/daovez" aria-label="X de David, abre otra pestaña" title="X" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="23" height="23" fill="currentColor" aria-hidden="true">
            <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-7.4L5.5 22H2.4l8.2-9.4L.8 2h6.5l4.5 6.8L18.9 2ZM17.8 20h1.7L6.3 4H4.5l13.3 16Z" />
          </svg>
        </a>
        <a href="https://www.instagram.com/daovez.flow/?hl=es" aria-label="Instagram de David, abre otra pestaña" title="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section id="works">
    <div class="works-heading">
      <h2 class="eyebrow">Works</h2>
  <div class="technologies" aria-label="Tecnologías">
    <span class="technology" title="HTML"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" role="img" aria-label="HTML"><title>HTML</title><path fill-rule="evenodd" d="M2 1l1.8 20L12 23l8.2-2L22 1H2Zm16 6H8l.3 3H18l-.8 8-5.2 1.5L6.8 18l-.4-4h2.5l.2 2 2.9.8 2.9-.8.3-3.5H6L5.3 4.5h13L18 7Z" /></svg></span>
    <span class="technology" title="CSS"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" role="img" aria-label="CSS"><title>CSS</title><path fill-rule="evenodd" d="M2 1l1.8 20L12 23l8.2-2L22 1H2Zm16.5 3.5-.3 2.5-7 3h6.7l-.8 8-5.1 1.5L6.8 18l-.4-4h2.5l.2 2 2.9.8 2.8-.8.3-3.5H6.2L6 10l7.1-3H5.8l-.3-2.5h13Z" /></svg></span>
    <span class="technology" title="JavaScript"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" role="img" aria-label="JavaScript"><title>JavaScript</title><path fill-rule="evenodd" d="M0 0h24v24H0V0Zm13 18.7c.6 1.3 1.8 2.3 3.8 2.3 2.1 0 3.7-1.1 3.7-3.1 0-1.8-1-2.6-2.9-3.4l-.6-.3c-.9-.4-1.3-.7-1.3-1.3 0-.5.4-.9 1-.9s1 .3 1.4 1l1.8-1.2c-.8-1.4-1.8-1.9-3.2-1.9-2 0-3.3 1.3-3.3 3 0 1.9 1.1 2.8 2.8 3.5l.6.3c1 .4 1.5.7 1.5 1.4 0 .6-.6 1-1.5 1-1.1 0-1.7-.6-2.2-1.4L13 18.7Zm-7.5.2c.6 1.3 1.7 2.1 3.3 2.1 2.1 0 3.5-1.1 3.5-3.5v-7.4H10v7.4c0 1.1-.4 1.4-1.1 1.4-.7 0-1-.5-1.4-1.1l-2 1.1Z" /></svg></span>
    <span class="technology" title="Python"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" role="img" aria-label="Python"><title>Python</title><path fill-rule="evenodd" d="M11.9 1C6.4 1 6.7 3.4 6.7 3.4v2.5H12v.8H4.6S1 6.3 1 12s3.1 5.5 3.1 5.5H6v-2.7s-.1-3.1 3.1-3.1h5.3s3 .1 3-3V3.6S17.9 1 11.9 1ZM9 2.6a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM18 6.5v2.7s.1 3.1-3.1 3.1H9.6s-3-.1-3 3v5.1S6.1 23 12.1 23s5.2-2.4 5.2-2.4v-2.5H12v-.8h7.4S23 17.7 23 12s-3.1-5.5-3.1-5.5H18ZM15 19.4a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z" /></svg></span>
    <span class="technology" title="PostgreSQL">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="PostgreSQL">
        <title>PostgreSQL</title>
        <path d="M8 16c-2 2-3 1-4-2C2 9 2 4 5 3c2-1 4 0 5 0 3-2 7-1 9 1 3 3 2 8 0 11-1 1-2 1-4 0m-5-12C7 4 6 7 7 10l2 4c1 2 0 4-2 5 2 1 4 0 5-2m3-12c-3-1-5 1-5 4 0 2 1 3 3 3v7c0 3 3 3 3 0v-7c2-2 2-5-1-7Zm1 9c2 2 3 2 5 1-1 3-3 3-5 2" />
        <circle cx="12.5" cy="7.5" r=".6" fill="currentColor" stroke="none" />
      </svg>
    </span>
    <span class="technology" title="Git"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" role="img" aria-label="Git"><title>Git</title><path fill-rule="evenodd" d="M23.5 10.9 13.1.5a1.6 1.6 0 0 0-2.2 0L8.7 2.7l2.8 2.8a1.8 1.8 0 0 1 2.3 2.3l2.7 2.7a1.8 1.8 0 1 1-1.1 1.1l-2.6-2.6v6.9a1.8 1.8 0 1 1-1.6 0V8.8a1.8 1.8 0 0 1-.9-2.2L7.5 3.8.5 10.9a1.6 1.6 0 0 0 0 2.2l10.4 10.4a1.6 1.6 0 0 0 2.2 0l10.4-10.4a1.6 1.6 0 0 0 0-2.2Z" /></svg></span>
  </div>
    </div>

    <div class="projects">
      {
        projects.map((project) => (
          <article class="card">
            <a
              class="project-link"
              href={`/works/${project.slug}/`}
            >
              <div class="preview" aria-hidden="true">
                <svg class="project-icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  {project.slug === 'automatizador-emails' ? (
                    <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>
                  ) : (
                    <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18m-12 4-2 2 2 2m6-4 2 2-2 2" /></>
                  )}
                </svg>
                <span class="preview-caption">{project.caption}</span>
              </div>

              <div class="card-copy">
                <h3>{project.title}</h3>
                <p>{project.description}</p>

                <div class="card-bottom">
                  <span class="status">En desarrollo</span>
                  <span class="detail">Ver proyecto ↗</span>
                </div>
              </div>
            </a>
          </article>
        ))
      }
      {[1, 2].map(() => (
        <article class="card upcoming"><div class="card-copy"><h3>Próximamente</h3></div></article>
      ))}
    </div>
  </section>


</Layout>

<style>
  /* Presentación */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: 35px;
    padding: 30px 0 40px;
  }

  .eyebrow {
    margin-bottom: 20px;
    font-size: 11px;
  }

  h1 {
    margin-bottom: 16px;
    font-size: clamp(28px, 3.4vw, 36px);
    line-height: 1.15;
  }


  .lead {
    max-width: 460px;
    margin-bottom: 12px;
    color: var(--text);
    font-size: 18px;
    line-height: 1.45;
  }

  .summary {
    max-width: 460px;
    margin-bottom: 0;
    font-size: 16px;
  }

  .button {
    padding: 8px 21px;
    font-size: 14px;
  }

  /* Foto y redes */
  .portrait-area {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .portrait {
    display: block;
    width: min(220px, 100%);
    justify-self: center;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    padding: 10px;
    background: #a3a3a3;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .social {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }

  /* Proyectos */
  .projects {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: Arial, Helvetica, sans-serif;
    background: rgba(240, 238, 233, 0.045);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(240, 238, 233, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    border-radius: 10px;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .project-link {
    display: block;
    height: 100%;
  }

  .project-link:hover {
    color: inherit;
  }

  .preview {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 84px;
    padding: 12px 8px 8px;
    gap: 8px;
    background: rgba(240, 238, 233, 0.025);
    border-bottom: 1px solid rgba(240, 238, 233, 0.07);
    border-radius: 10px 10px 0 0;
  }

  .project-icon {
    display: block;
    flex-shrink: 0;
    color: var(--accent);
  }

  .preview-caption {
    color: #a7b0aa;
    font-size: 11px;
    text-align: center;
    line-height: 1.4;
  }

  .card-copy {
    padding: 12px;
  }

  .card-copy h3 {
    margin-bottom: 8px;
    font-size: 16px;
  }

  .card-copy p {
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 1.5;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .status,
  .detail {
    font-size: 12px;
  }

  .detail {
    color: var(--accent);
  }

  .works-heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-bottom: 14px;
  }

  .works-heading .eyebrow { margin: 0; }

  /* Tecnologías */
  .technologies {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 13px;
  }

  /* Móvil */

  .social svg { display: block; }
  .upcoming { display: grid; place-items: center; min-height: 180px; }
  .upcoming h3 { margin: 0; color: var(--muted); }
  .technology { display: inline-flex; }
  .technology svg { display: block; width: 28px; height: 28px; }

  @media (min-width: 651px) and (max-width: 900px) {
    .projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about { gap: 24px; }
  }

  @media (max-width: 650px) {
    .about {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 22px 0 35px;
    }

    .portrait-area {
      grid-row: 1;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .social { flex-direction: row; flex-wrap: wrap; justify-content: center; }

    .portrait {
      max-width: 190px;
    }

    h1 {
      font-size: clamp(26px, 6.5vw, 30px);
    }

    .lead {
      font-size: 18px;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .technologies {
      gap: 12px;
    }
  }
</style>
