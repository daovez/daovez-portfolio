---
import Layout from '../layouts/Layout.astro';
import { getNotes, formatDate } from '../lib/notes';
const [latest, ...previous] = await getNotes();
---
<Layout title="Blog" description="Notas sobre desarrollo web, automatización e IA">
  <div class="blog">
    <header class="blog-heading">
      <a class="back" href="/">← Volver</a>
      <h1>blog // daovez</h1>
      <p>Notas sobre desarrollo web, automatización e IA</p>
      <nav class="filters" aria-label="Filtrar notas">
        <button class="filter-active" type="button" data-note-filter="Todos" aria-pressed="true">Todos</button>
        <button type="button" data-note-filter="Automatización" aria-pressed="false">Automatización</button>
        <button type="button" data-note-filter="IA &amp; Agentes" aria-pressed="false">IA &amp; Agentes</button>
        <button type="button" data-note-filter="Desarrollo Web" aria-pressed="false">Desarrollo Web</button>
        <button type="button" data-note-filter="Seguridad" aria-pressed="false">Seguridad</button>
      </nav>
    </header>
    {latest && <article class="latest" data-note-category={latest.data.category}>
      <div class="latest-meta"><span>DESTACADO</span><span>{latest.data.category}</span></div>
      <h2><a href={`/blog/${latest.id}/`}>{latest.data.title}</a></h2>
      <p>{latest.data.description}</p>
      <div class="note-meta"><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time><span>{latest.data.readTime} de lectura</span><a class="accent" href={`/blog/${latest.id}/`}>Leer nota <span aria-hidden="true">→</span></a></div>
    </article>}
    {previous.length > 0 && <section class="notes-index" aria-labelledby="notes-title">
      <div class="index-heading"><span id="notes-title">Índice técnico</span><span>{previous.length} notas</span></div>
      <ul class="previous" aria-label="Notas anteriores">
        {previous.map((note, index) => <li data-note-category={note.data.category}>
          <a class="note-link" href={`/blog/${note.id}/`}>
            <span class="note-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="note-title"><span class="category">{note.data.category}</span><h3>{note.data.title}</h3><div class="note-details"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time><span>{note.data.readTime} de lectura</span></div></div>
            <span class="note-arrow" aria-hidden="true">↗</span>
          </a>
        </li>)}
      </ul>
    </section>}
  </div>
</Layout>
<style>
  .blog { width:100%; margin:0; padding:12px 0 48px; overflow-wrap:anywhere; }
  .blog-heading { margin-bottom: 24px; }
  .back { display: inline-flex; margin-bottom: 12px; color: var(--muted); font-size: 13px; transition: color .2s; }
  .back:hover { color: var(--text); }
  h1 { margin: 0 0 10px; color: var(--text); font-size: clamp(40px, 5vw, 64px); letter-spacing: -.055em; line-height: 1; }
  .blog-heading > p { margin: 0; color: var(--muted); font-size: 17px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .filters button { min-height: 44px; padding: 7px 14px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--muted); cursor: pointer; font-size: 12px; transition: border-color .2s, color .2s, background-color .2s; }
  .filters button:hover, .filters button:focus-visible, .filters .filter-active { border-color: var(--accent); background: var(--panel); color: var(--text); }
  .latest { padding:30px 0; border-block:1px solid var(--line); }
  .latest-meta, .note-meta, .index-heading, .note-details { display: flex; align-items: center; gap: 16px; color: var(--muted); font-size: 12px; }
  .latest-meta { justify-content: space-between; color: var(--accent); font: 11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing: .08em; }
  .latest h2 { max-width: 700px; margin: 16px 0 12px; font-size: clamp(26px, 3.2vw, 42px); letter-spacing: -.04em; line-height: 1.1; }
  .latest h2 a:hover { color: var(--text); }
  .latest > p { max-width: 640px; margin: 0; color: var(--muted); font-size: 16px; line-height: 1.6; }
  .note-meta { margin-top: 16px; }
  time { color: var(--muted); font: 12px/1.5 'Space Grotesk', sans-serif; }
  .note-meta a { display:inline-flex; align-items:center; gap:8px; min-height:44px; margin-left:auto; }
  .notes-index { margin-top: 28px; }
  .index-heading { justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid var(--line); color: var(--text); font: 11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing: .12em; text-transform: uppercase; }
  .index-heading span:last-child { color: var(--muted); }
  .previous { list-style: none; margin: 0; padding: 0; }

  .previous li { border-bottom:1px solid var(--line); }
  .note-link { display:grid; grid-template-columns:28px minmax(0,1fr) 24px; align-items:start; gap:16px; padding:20px 0; }
  .note-number { padding-top:3px; color:var(--accent); font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; }
  .note-title { min-width:0; }
  .category { display:block; margin-bottom:6px; color:var(--accent); font:10px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; }
  .note-title h3 { margin:0; color:var(--text); font-size:clamp(18px,2.2vw,22px); font-weight:500; line-height:1.3; letter-spacing:-.025em; }
  .note-details { flex-wrap:wrap; gap:4px 14px; margin-top:8px; font-size:11px; }
  .note-arrow { align-self:center; color:var(--accent); font-size:22px; line-height:1; text-align:center; }
  .note-link:hover h3 { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:4px; }
  .previous li[hidden], .latest[hidden] { display:none; }
  @media (max-width: 650px) {
    .blog { padding: 10px 0 48px; }
    .latest { padding: 24px 0; }
    .latest-meta { align-items: flex-start; flex-direction: column; gap: 6px; }
    .note-meta { align-items: flex-start; flex-wrap: wrap; }
    .note-meta a { width: 100%; margin-left: 0; }
    .note-link { grid-template-columns:22px minmax(0,1fr) 20px; gap:10px; padding:18px 0; }
  }
</style>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-note-filter]');
  const notes = document.querySelectorAll<HTMLElement>('[data-note-category]');
  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.dataset.noteFilter ?? 'Todos';
      filters.forEach((item) => {
        const active = item === filter;
        item.classList.toggle('filter-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      notes.forEach((note) => {
        note.hidden = category !== 'Todos' && note.dataset.noteCategory !== category;
      });
    });
  });
</script>
