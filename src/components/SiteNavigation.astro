---
interface Props {
  path: string;
}

const { path } = Astro.props;
---
<header class="site-header">
<nav aria-label="Navegación principal">
<a href="/" aria-current={path === '/' ? 'page' : undefined}>Inicio</a>
<a href="/about/" aria-current={/^\/about\/?$/.test(path) ? 'page' : undefined}>Sobre mí</a>
<a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
</nav>
</header>
<style>
.site-header { justify-content:center; }
nav { justify-content:center; }
nav > a { justify-content:center; }
nav > a[aria-current="page"] { text-decoration:underline; text-underline-offset:6px; text-decoration-thickness:1px; }
</style>
